# =============================================================================
# Evo 环境变量全集（复制为 .env 后按需修改）
#   cp .env.example .env
# 切勿把含真实密钥的 .env 提交到 Git。
# 改完后需重启 API / agent-runner /（前端构建时）web。
# =============================================================================

# -----------------------------------------------------------------------------
# API（apps/api · evo_api.config.Settings）
# -----------------------------------------------------------------------------

# 数据库 SQLAlchemy URL
# - 本地默认：仓库根目录 evo.db（sqlite）
# - Docker Compose 示例：postgresql+psycopg://evo:evo@db:5432/evo
DATABASE_URL=sqlite:///./evo.db

# 行情模式
# - mock：本地假数据（测试/离线）
# - live：真实行情（a-stock-data：腾讯报价/K线、交易日历等，需外网）
MARKET_DATA_MODE=mock

# 管理台 /admin/* 的 Bearer Token（前端「保存 Token」填同一个值）
ADMIN_TOKEN=dev-admin-token

# 纸面账户初始现金（仅账户首次创建时生效；也可在 config/instruments.yaml 的 default_cash 配置）
INITIAL_CASH=1000000

# CORS 允许来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 品种规则配置文件路径（默认：仓库根目录 config/instruments.yaml）
# 内含 ETF 手数、费率、代码前缀启发式等，不是白名单限制
INSTRUMENTS_CONFIG=./config/instruments.yaml

# -----------------------------------------------------------------------------
# Agent Runner（apps/agent-runner · RunnerSettings）
# -----------------------------------------------------------------------------

# 投资系统 API 根地址（runner 只通过 HTTP 调 Capability）
API_BASE=http://127.0.0.1:8000
# 常驻：uv run agent-runner serve
# 联调：uv run agent-runner once --mode intraday|postclose

# LLM：OpenAI 兼容协议。留空 OPENAI_API_KEY 则走规则回退（不调模型）
# MiniMax 国内示例见下；也可换成官方 OpenAI 或其他兼容网关
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M3
# 国际站示例：
# OPENAI_BASE_URL=https://api.minimax.io/v1
# OpenAI 官方示例：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 资产类型：stock | etf | convertible_bond（也可用 config/instruments.yaml 的 default_stock_type）
STOCK_TYPE=etf
# 仅 STOCK_TYPE=stock 时生效：指数成分（默认沪深300）
UNIVERSE_INDEX=000300
# 每轮送给模型的候选数量
SCREEN_SIZE=30
# 盘中常驻轮询间隔（秒），默认 300=五分钟
INTRADAY_INTERVAL_SECONDS=300
# 盘中 / 盘后 agent loop 最大工具轮次
INTRADAY_MAX_TOOL_TURNS=8
POSTCLOSE_MAX_TOOL_TURNS=8

# 写入审计日志的 Actor 名
ACTOR=agent-runner

# -----------------------------------------------------------------------------
# Web 监督台（apps/web · Vite）
# 注意：VITE_* 在 npm run build / docker build 时打进前端包，改后需重新构建
# 本地 npm run dev 时也可依赖 vite.config.js 的 proxy，可不设
# -----------------------------------------------------------------------------

# 浏览器访问的 API 根地址（生产/ Docker 常用）
VITE_API_BASE=http://localhost:8000

# -----------------------------------------------------------------------------
# 非环境变量、但同属「可配置」的文件（供对照，勿写进 .env）
# -----------------------------------------------------------------------------
# config/instruments.yaml  — 品种 kind 规则、default_cash、费率、lot_size 等
# docker-compose.yml       — 容器内 DATABASE_URL / MARKET_DATA_MODE 等会覆盖此处
